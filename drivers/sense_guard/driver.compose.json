{
  "name": { "en": "Sense Guard", "sv": "Sense Guard" },
  "class": "other",
  "capabilities": [
    "onoff",
    "measure_water",
    "measure_pressure",
    "measure_temperature",
    "meter_water",
    "alarm_water"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "title": { "en": "Water valve", "sv": "Vattenventil" },
      "uiQuickAction": false
    },
    "measure_water": {
      "title": { "en": "Last flow", "sv": "Senaste flöde" }
    }
  },
  "platforms": ["local", "cloud"],
  "connectivity": ["cloud"],
  "images": {
    "small": "/drivers/sense_guard/assets/images/small.png",
    "large": "/drivers/sense_guard/assets/images/large.png"
  },
  "settings": [
    {
      "id": "allow_valve_control",
      "type": "checkbox",
      "label": { "en": "Allow Homey to control the valve", "sv": "Tillåt Homey att styra ventilen" },
      "hint": {
        "en": "Disable to prevent flows from accidentally shutting off the water",
        "sv": "Inaktivera för att förhindra att flows av misstag stänger av vattnet"
      },
      "value": false
    },
    {
      "id": "poll_interval_status",
      "type": "number",
      "label": { "en": "Status polling interval (seconds)", "sv": "Pollningsintervall för status (sekunder)" },
      "min": 30,
      "max": 600,
      "value": 90
    }
  ],
  "pair": [
    { "id": "login_credentials", "template": "login_credentials" },
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" }
  ]
}
